@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap");

:root { --paper: #f7f7f2; --surface: #fff; --ink: #1f2924; --muted: #707a73; --line: #e4e7e1; --green: #2f6755; --green-dark: #204e40; --green-pale: #e8f0eb; --coral: #e97e68; --sand: #ede9df; --font: "IBM Plex Sans Arabic",Tahoma,Arial,sans-serif; --max: 1160px; --pad: clamp(18px,5vw,64px); --shadow: 0 12px 34px rgba(32,53,43,.08); }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; scroll-padding-top: 90px; }

body { margin: 0px; color: var(--ink); background: var(--paper); font-family: var(--font); font-size: 15px; line-height: 1.7; -webkit-font-smoothing: antialiased; }

button, input, select { font: inherit; }

button, a { -webkit-tap-highlight-color: transparent; }

button { cursor: pointer; }

a { color: inherit; text-decoration: none; }

svg { width: 20px; height: 20px; fill: none; stroke: currentcolor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

.section-wrap { width: min(var(--max),calc(100% - var(--pad)*2)); margin-inline: auto; }

.skip-link { position: absolute; top: -60px; right: 15px; z-index: 99; background: var(--ink); color: white; padding: 9px 15px; border-radius: 8px; }

.skip-link:focus { top: 12px; }

.topbar { height: 78px; width: min(var(--max),calc(100% - var(--pad)*2)); margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; }

.brand { display: inline-flex; align-items: center; gap: 9px; color: var(--green); font-size: 21px; font-weight: 700; white-space: nowrap; }

.brand-symbol { width: 30px; height: 30px; display: grid; place-items: center; }

.brand-symbol svg { width: 30px; height: 30px; stroke: none; }

.desktop-nav { display: flex; align-items: center; gap: 37px; margin-right: 45px; }

.nav-link { font-size: 13px; color: rgb(115, 125, 117); transition: color 0.2s; }

.nav-link:hover, .nav-link.active { color: var(--green); font-weight: 600; }

.top-actions { display: flex; align-items: center; gap: 14px; }

.demo-badge { display: inline-flex; align-items: center; gap: 7px; background: rgb(241, 237, 227); border: 1px solid rgb(229, 224, 212); border-radius: 99px; padding: 5px 11px; color: rgb(112, 101, 80); font-size: 10px; font-weight: 600; }

.demo-badge i { width: 6px; height: 6px; border-radius: 50%; background: rgb(212, 163, 81); }

.profile-button { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: white; color: rgb(115, 125, 117); display: grid; place-items: center; }

.profile-button:hover { border-color: var(--green); color: var(--green); }

.hero { background: var(--green); color: rgb(255, 255, 255); padding: 42px max(var(--pad),calc((100vw - var(--max))/2)) 34px; position: relative; overflow: hidden; }

.hero::after { content: ""; position: absolute; left: -100px; top: -170px; width: 390px; height: 390px; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 50%; box-shadow: rgba(255, 255, 255, 0.03) 0px 0px 0px 35px, rgba(255, 255, 255, 0.024) 0px 0px 0px 75px; pointer-events: none; }

.hero-copy { position: relative; z-index: 1; max-width: var(--max); margin: 0px auto 24px; }

.hero-overline { font-size: 11px; color: rgb(220, 234, 225); margin: 0px 0px 8px; display: flex; align-items: center; gap: 8px; }

.hero-overline span { width: 21px; height: 1px; background: rgb(216, 232, 223); }

.hero h1 { font-size: clamp(34px, 5vw, 54px); line-height: 1.23; letter-spacing: -0.045em; margin: 0px; font-weight: 600; }

.hero h1 em { font-family: Georgia, serif; font-weight: 400; color: rgb(227, 215, 180); letter-spacing: -0.02em; }

.hero-subtitle { font-size: 13px; color: rgb(219, 230, 223); margin: 8px 0px 0px; max-width: 420px; }

.search-panel { position: relative; z-index: 2; width: min(var(--max),100%); margin: auto; background: var(--surface); color: var(--ink); display: grid; grid-template-columns: 1.45fr 1fr 1fr 1fr 116px; align-items: stretch; padding: 7px; border-radius: 17px; box-shadow: rgba(18, 44, 32, 0.2) 0px 18px 50px; }

.search-field { min-width: 0px; padding: 5px 16px; display: flex; flex-direction: column; justify-content: center; border-left: 1px solid var(--line); }

.search-field:first-child { padding-right: 20px; }

.field-label { font-weight: 600; font-size: 11px; margin-bottom: 3px; }

.field-control { display: flex; align-items: center; gap: 7px; color: rgb(139, 149, 142); min-width: 0px; }

.field-control svg { width: 16px; height: 16px; flex: 0 0 auto; }

.field-control input, .field-control select { min-width: 0px; width: 100%; border: 0px; outline: 0px; background: transparent; color: rgb(85, 95, 88); font-size: 11px; padding: 2px 0px; }

.field-control input::placeholder { color: rgb(157, 165, 158); }

.field-control input[type="date"] { font-family: var(--font); font-size: 10px; }

.field-control select { appearance: none; cursor: pointer; }

.search-button { display: flex; align-items: center; justify-content: center; gap: 7px; background: var(--green); color: white; border: 0px; border-radius: 12px; font-size: 12px; font-weight: 600; padding: 10px; transition: background 0.2s; }

.search-button:hover { background: var(--green-dark); }

.search-button svg { width: 18px; height: 18px; }

.demo-note { position: relative; z-index: 1; text-align: center; font-size: 10px; color: rgb(216, 231, 222); margin: 15px auto 0px; }

.demo-note span { margin-left: 5px; }

.explore { padding-block: 52px 75px; }

.explore-top { display: flex; align-items: end; justify-content: space-between; gap: 15px; }

.section-eyebrow { font-size: 10px; color: var(--green); font-weight: 600; margin: 0px 0px 3px; }

.explore-top h2 { font-size: clamp(24px, 3vw, 31px); line-height: 1.4; margin: 0px; font-weight: 600; letter-spacing: -0.035em; }

.filter-button { border: 1px solid rgb(217, 222, 216); background: transparent; border-radius: 10px; min-height: 39px; padding: 7px 12px; display: inline-flex; align-items: center; gap: 7px; color: rgb(95, 106, 98); font-size: 10px; white-space: nowrap; }

.filter-button svg { width: 17px; height: 17px; }

.filter-button:hover { background: white; border-color: rgb(170, 184, 174); }

.category-row { display: flex; gap: 24px; overflow: auto; padding: 21px 0px 14px; border-bottom: 1px solid var(--line); scrollbar-width: none; }

.category-row::-webkit-scrollbar { display: none; }

.category { flex: 0 0 auto; min-width: 68px; border-width: 0px 0px 2px; border-style: none none solid; border-color: currentcolor currentcolor transparent; border-image: none; background: none; color: rgb(123, 133, 125); display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 0px 4px 9px; font-size: 10px; transition: color 0.2s, border-color 0.2s; }

.category:hover, .category.active { color: var(--green); }

.category.active { border-color: var(--green); font-weight: 600; }

.category-icon { font-family: Arial, sans-serif; font-size: 20px; line-height: 1; color: rgb(137, 148, 139); }

.category.active .category-icon { color: var(--green); }

.results-meta { display: flex; align-items: center; justify-content: space-between; margin: 20px 0px 14px; }

.results-meta p { font-size: 11px; color: rgb(116, 128, 119); margin: 0px; }

.favorites-filter { border: 0px; background: none; color: rgb(115, 128, 120); font-size: 10px; display: inline-flex; align-items: center; gap: 5px; padding: 5px; }

.favorites-filter:hover, .favorites-filter.active { color: var(--coral); }

.favorites-filter span { font-size: 17px; line-height: 1; }

.listing-grid { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 25px 20px; }

.listing-card { min-width: 0px; animation: 0.38s ease 0s 1 normal both running card-in; }

.listing-photo-wrap { position: relative; aspect-ratio: 1.18 / 1; overflow: hidden; border-radius: 15px; background: rgb(229, 231, 226); }

.listing-photo { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.3, 1); }

.listing-card:hover .listing-photo { transform: scale(1.045); }

.photo-tag { position: absolute; top: 11px; right: 11px; background: rgba(255, 255, 255, 0.92); border-radius: 99px; padding: 5px 9px; font-size: 9px; color: rgb(72, 84, 75); font-weight: 600; box-shadow: rgba(0, 0, 0, 0.05) 0px 3px 8px; }

.favorite-button { position: absolute; top: 10px; left: 10px; width: 34px; height: 34px; border: 0px; border-radius: 50%; background: rgba(255, 255, 255, 0.93); color: rgb(70, 83, 74); display: grid; place-items: center; transition: transform 0.2s, color 0.2s; }

.favorite-button:hover { transform: scale(1.09); }

.favorite-button svg { width: 18px; height: 18px; stroke-width: 1.6; }

.favorite-button.is-saved { color: var(--coral); }

.favorite-button.is-saved svg { fill: var(--coral); stroke: var(--coral); }

.listing-info { padding: 10px 1px 0px; }

.listing-title-row { display: flex; align-items: start; justify-content: space-between; gap: 8px; }

.listing-title { font-size: 12px; font-weight: 600; line-height: 1.5; margin: 0px; color: rgb(49, 60, 52); }

.listing-rating { white-space: nowrap; display: flex; align-items: center; gap: 4px; font-size: 10px; color: rgb(77, 89, 81); }

.listing-rating span { color: rgb(218, 166, 90); }

.listing-location, .listing-description { font-size: 10px; color: rgb(129, 138, 130); margin: 3px 0px 0px; }

.listing-description { color: rgb(147, 155, 148); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.price-row { display: flex; align-items: baseline; gap: 4px; margin-top: 9px; }

.price-row strong { font-size: 12px; color: rgb(53, 65, 57); }

.price-row span { font-size: 9px; color: rgb(138, 147, 139); }

.sample-price { font-size: 8px; color: rgb(155, 135, 94); background: rgb(243, 239, 229); border-radius: 4px; padding: 2px 5px; margin-right: auto; }

.details-button { margin-top: 9px; border: 0px; background: none; color: var(--green); font-size: 10px; font-weight: 600; padding: 0px; }

.details-button:hover { text-decoration: underline; }

.empty-state { text-align: center; padding: 45px 18px; background: white; border: 1px dashed rgb(220, 226, 219); border-radius: 16px; margin-top: 15px; }

.empty-icon { font-size: 32px; color: rgb(152, 167, 154); }

.empty-state h3 { font-size: 17px; margin: 8px 0px 2px; }

.empty-state p { font-size: 11px; color: rgb(121, 132, 123); margin: 0px 0px 13px; }

.reset-button { border: 0px; background: var(--green); color: white; border-radius: 9px; padding: 9px 14px; font-size: 11px; }

.load-more-wrap { text-align: center; padding-top: 32px; }

.load-more { border: 1px solid rgb(182, 193, 184); color: var(--green); background: transparent; border-radius: 10px; padding: 10px 19px; font-size: 11px; transition: background 0.2s; }

.load-more:hover { background: var(--green-pale); }

.load-more span { margin-right: 8px; }

.how-section { background: rgb(238, 239, 233); padding-block: 70px; }

.how-inner { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 10%; align-items: center; }

.how-title h2 { font-size: clamp(33px, 4vw, 46px); line-height: 1.3; margin: 0px; letter-spacing: -0.04em; }

.how-title h2 em { font-family: Georgia, serif; font-weight: 400; color: var(--green); }

.how-title > p:last-child { max-width: 290px; color: rgb(116, 128, 119); font-size: 11px; }

.how-steps { border-top: 1px solid rgb(214, 218, 210); }

.how-step { display: grid; grid-template-columns: 40px 1fr 32px; align-items: center; gap: 14px; padding: 18px 0px; border-bottom: 1px solid rgb(214, 218, 210); }

.how-step > span { font: 10px Arial, sans-serif; color: rgb(145, 160, 145); }

.how-step h3 { font-size: 13px; margin: 0px 0px 2px; }

.how-step p { font-size: 10px; color: rgb(120, 130, 120); margin: 0px; }

.how-step > b { color: var(--green); font-weight: 400; font-size: 22px; text-align: center; }

.trust-note { display: flex; align-items: flex-start; gap: 14px; padding-block: 36px; margin-block: 22px; }

.trust-icon { width: 33px; height: 33px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 50%; background: rgb(230, 239, 231); color: var(--green); font-size: 16px; }

.trust-note h2 { font-size: 13px; margin: 0px 0px 3px; }

.trust-note p { font-size: 10px; color: rgb(115, 126, 116); margin: 0px; max-width: 700px; }

.footer { background: rgb(240, 240, 233); border-top: 1px solid rgb(227, 229, 222); padding: 22px 0px 28px; }

.footer-inner { display: flex; align-items: center; gap: 20px; }

.footer-brand { font-size: 15px; }

.footer-brand .brand-symbol, .footer-brand .brand-symbol svg { width: 23px; height: 23px; }

.footer-inner > p { font-size: 9px; color: rgb(137, 145, 136); margin: 0px auto 0px 0px; }

.top-link { font-size: 10px; color: rgb(101, 115, 105); }

.mobile-nav { display: none; }

.detail-dialog { width: min(540px, 100% - 28px); max-height: min(90dvh, 760px); padding: 0px; border: 0px; border-radius: 18px; overflow: auto; background: white; color: var(--ink); box-shadow: rgba(22, 38, 29, 0.24) 0px 25px 80px; }

.detail-dialog::backdrop { background: rgba(19, 31, 24, 0.48); backdrop-filter: blur(3px); }

.dialog-close { position: absolute; top: 12px; left: 12px; width: 37px; height: 37px; border: 0px; border-radius: 50%; background: rgba(255, 255, 255, 0.95); font-size: 23px; color: rgb(72, 84, 75); z-index: 2; }

.dialog-photo { height: 230px; background-size: cover; background-position: center center; }

.dialog-content { padding: 20px 24px 24px; }

.dialog-kicker { font-size: 10px; color: rgb(125, 136, 126); margin: 0px; }

.dialog-content h2 { font-size: 22px; margin: 3px 0px 8px; }

.dialog-description { font-size: 12px; line-height: 1.9; color: rgb(104, 116, 106); }

.dialog-facts { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0px; }

.dialog-facts span { background: rgb(241, 243, 237); color: rgb(93, 107, 96); border-radius: 99px; padding: 5px 10px; font-size: 9px; }

.dialog-price { font-size: 12px; font-weight: 600; }

.dialog-price small { font-size: 9px; color: rgb(138, 147, 139); font-weight: 400; }

.dialog-alert { background: rgb(246, 242, 232); border: 1px solid rgb(235, 228, 211); color: rgb(119, 106, 78); border-radius: 9px; padding: 10px 12px; font-size: 10px; margin: 15px 0px; }

.dialog-book { width: 100%; border: 0px; border-radius: 10px; background: rgb(217, 223, 217); color: rgb(122, 133, 123); padding: 12px; font-size: 12px; cursor: not-allowed; }

.toast { position: fixed; z-index: 50; right: 50%; bottom: 22px; transform: translate(50%, 20px); opacity: 0; pointer-events: none; background: rgb(32, 43, 36); color: white; padding: 10px 16px; border-radius: 99px; font-size: 11px; box-shadow: var(--shadow); transition: opacity 0.22s, transform 0.22s; max-width: calc(100% - 30px); text-align: center; }

.toast.show { opacity: 1; transform: translate(50%, 0px); }

.noscript { text-align: center; padding: 20px; color: rgb(140, 67, 47); background: rgb(255, 241, 232); }

@keyframes card-in { 
  0% { opacity: 0; transform: translateY(8px); }
  100% { opacity: 1; transform: none; }
}

:focus-visible { outline: rgb(215, 124, 100) solid 2px; outline-offset: 3px; }

button:disabled { cursor: not-allowed; }

@media (max-width: 850px) {
  :root { --pad: 28px; }
  .desktop-nav { margin-right: 15px; gap: 22px; }
  .search-panel { grid-template-columns: 1.35fr 1fr 1fr 1fr 92px; }
  .search-field { padding-inline: 10px; }
  .listing-grid { gap: 22px 14px; }
  .how-inner { gap: 6%; }
}

